# ── App ──
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database ──
# Runtime role (non-superuser, RLS enforced). Created by migrations; LOGIN enabled
# by `npm run db:migrate` when APP_DB_PASSWORD is set.
DATABASE_URL=postgres://lifeos_app:lifeos_app@localhost:5432/lifeos_dev
# Owner role, used only by migrations.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/lifeos_dev
APP_DB_PASSWORD=lifeos_app

# ── Auth ── (generate: openssl rand -base64 48)
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage ── local | r2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/objects
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── AI ── mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_FAST=
AI_MODEL_STRONG=

# ── Field encryption ── 32 random bytes, base64 (openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=replace-me-with-32-bytes-base64-encoded-key

# ── Email reminders ── log | resend
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM="LIFEOS <reminders@example.com>"

# ── Email forwarding + Google Takeout import ── see docs/EMAIL_FORWARDING.md
# Leave blank to hide forwarding. The secret must match the Cloudflare Email Worker's.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# MAX_IMPORT_BYTES=1073741824
# MAX_IMPORT_DOCUMENTS=300

# ── Connect Gmail / Outlook ── see docs/CONNECT_INBOX.md (Gmail falls back to GOOGLE_CLIENT_ID/SECRET)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MAIL_SYNC_BACKFILL_DAYS=90

# ── Web policy lookups ── store return policies / manufacturer warranties when a receipt doesn't say.
# Only the store/brand + product type are searched; results are shared across users for 30 days.
# POLICY_LOOKUP_ENABLED=true
# Max NEW lookups per day across all users (each = web search + model tokens).
# POLICY_LOOKUP_DAILY_LIMIT=100

# ── Jobs ── queue (pg-boss + worker) | inline (in-process; tests/simple dev)
JOBS_MODE=queue
